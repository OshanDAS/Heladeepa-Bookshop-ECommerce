{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "allure:generate": "npx allure generate allure-results --clean -o allure-report",
    "allure:generate:single": "npx allure generate allure-results --clean --single-file -o allure-report-single",
    "clean:allure": "node -e \"const fs=require('fs'); for (const p of ['allure-results','allure-report','allure-report-single']) fs.rmSync(p,{recursive:true,force:true});\"",
    "test:e2e:clean": "npm run clean:allure && npm run test:e2e",
    "test:e2e:headed:clean": "npm run clean:allure && npm run test:e2e:headed",
    "allure:fresh": "npm run test:e2e:clean && npm run allure:generate",
    "allure:fresh:headed": "npm run test:e2e:headed:clean && npm run allure:generate"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@heroicons/react": "^1.0.6",
    "@mui/icons-material": "^7.0.2",
    "@mui/material": "^7.0.2",
    "@tailwindcss/vite": "^4.0.14",
    "@tanstack/react-table": "^8.21.3",
    "antd": "^5.24.5",
    "axios": "^1.8.4",
    "framer-motion": "^10.16.4",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.483.0",
    "papaparse": "^5.5.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-dropzone": "^14.3.8",
    "react-helmet": "^6.1.0",
    "react-helmet-async": "^1.3.0",
    "react-router-dom": "^6.4.5",
    "react-slick": "^0.30.3",
    "react-toastify": "^11.0.5",
    "recharts": "^2.15.3",
    "swiper": "^11.2.6",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.53.2",
    "@eslint/js": "^9.21.0",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "allure-commandline": "^2.34.1",
    "allure-playwright": "^3.3.3",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.0.14",
    "vite": "^6.2.0"
  }
}
